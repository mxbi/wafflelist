# Wafflelist reverse proxy.
#
# Copy to /etc/caddy/Caddyfile (or import it from your existing one) and replace
# the hostnames. Per-PR preview blocks are generated by wafflelist-ctl into
# /etc/caddy/wafflelist-previews/ and picked up by the import at the bottom.

wafflelist.mxbi.net {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}

# Preview sites, one generated file per open PR:
#   pr-123.preview.wafflelist.mxbi.net -> 127.0.0.1:31123
#
# Each hostname gets its own certificate over HTTP-01, so no wildcard
# certificate (and no DNS-01 plugin) is needed. You do need a wildcard DNS
# record: *.preview.wafflelist.mxbi.net -> your VPS IP.
#
# The glob must match at least one file or Caddy errors, so install.sh drops a
# placeholder .caddy file in that directory.
import /etc/caddy/wafflelist-previews/*.caddy
