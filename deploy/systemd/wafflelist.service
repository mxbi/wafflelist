[Unit]
Description=Wafflelist (production)
Documentation=https://github.com/mxbi/wafflelist
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=wafflelist
Group=wafflelist

# cwd decides where src/lib/server/db.ts puts data/wafflelist.db, so it must be
# the persistent tree - never the release directory, which deploys prune.
WorkingDirectory=/srv/wafflelist/production
ExecStart=/usr/bin/node current/build/index.js
EnvironmentFile=/etc/wafflelist/production.env

Restart=always
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=20

# --- sandboxing -----------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Node's JIT needs writable-executable pages, so MemoryDenyWriteExecute stays off.
MemoryDenyWriteExecute=false

# ProtectSystem=strict makes the whole hierarchy read-only; grant back only
# the production tree.
ReadWritePaths=/srv/wafflelist/production

# Resource ceilings so a runaway release cannot take the host down.
MemoryMax=768M
TasksMax=256

[Install]
WantedBy=multi-user.target
